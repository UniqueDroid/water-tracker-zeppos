{
  "configVersion": "v3",
  "app": {
    "appId": 2000007,
    "appName": "Water Tracker",
    "appType": "app",
    "version": { "code": 1, "name": "1.0.0" },
    "icon": "icon.png",
    "vender": "Jan",
    "description": "Track daily water intake, persisted on the watch"
  },
  "permissions": [ "data:os.device.info", "device:os.local_storage" ],
  "runtime": {
    "apiVersion": { "compatible": "3.0.0", "target": "3.0.0", "minVersion": "3.0" }
  },
  "targets": {
    "PikeW": {
      "module": {
        "page": { "pages": [ "page/index" ] },
        "setting": { "path": "setting/index" }
      },
      "platforms": [ { "name": "PikeW", "deviceSource": 11206915 } ]
    }
  },
  "i18n": {
    "en-US": { "appName": "Water Tracker" },
    "de-DE": { "appName": "Water Tracker" }
  },
  "defaultLanguage": "en-US"
}
